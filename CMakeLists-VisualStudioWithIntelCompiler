# ======================================================================
# Set Intel oneAPI DPC++/C++ Compiler
# ======================================================================
find_program(ICX_COMPILER icx 
    HINTS 
        "C:/Program Files (x86)/Intel/oneAPI/compiler/latest/bin"
        "C:/Program Files/Intel/oneAPI/compiler/latest/bin"
    NO_DEFAULT_PATH
)
if(NOT ICX_COMPILER)
    message(FATAL_ERROR "Intel oneAPI DPC++/C++ Compiler (icx) not found. Ensure Intel oneAPI is installed and setvars.bat is run.")
endif()
message(STATUS "Found icx at: ${ICX_COMPILER}")
set(CMAKE_CXX_COMPILER "${ICX_COMPILER}")
execute_process(
    COMMAND "${ICX_COMPILER}" --version
    OUTPUT_VARIABLE ICX_VERSION_OUTPUT
    RESULT_VARIABLE ICX_VERSION_RESULT
)
if(ICX_VERSION_RESULT EQUAL 0)
    message(STATUS "icx version: ${ICX_VERSION_OUTPUT}")
else()
    message(FATAL_ERROR "Failed to run icx --version. Ensure icx is executable.")
endif()
