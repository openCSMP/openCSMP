cmake_minimum_required(VERSION 3.18...3.28)

project(open-csmp 
        VERSION 23 
        DESCRIPTION "OpenCSMP library from Melbourne GitLab repository" 
        LANGUAGES CXX)

  # Optionally set things like CMAKE_CXX_STANDARD, CMAKE_POSITION_INDEPENDENT_CODE here
   set(CMAKE_CXX_STANDARD 17)
   set(CMAKE_CXX_STANDARD_REQUIRED ON)
   # Let's ensure -std=c++xx instead of -std=g++xx
   set(CMAKE_CXX_EXTENSIONS OFF)

   # Define your library source files (excluding SAMG files)
   file(GLOB_RECURSE LIBRARY_SOURCE_FILES
    "source/modules/*.cpp"
)

   # Define your library headers (excluding samg.h)
   file(GLOB_RECURSE LIBRARY_HEADER_FILES
    "source/includes/*.h"
    "thirdparty/plf_colony/plf_colony.h"
)

# Define a function to extract unique directory names from a list of xiheader file paths
function(get_directories result)
    set(dir_list "")
    foreach(file_path ${ARGN})
        get_filename_component(dir_path ${file_path} DIRECTORY)
        list(APPEND dir_list ${dir_path})
    endforeach()
    list(REMOVE_DUPLICATES dir_list)
    set(${result} ${dir_list} PARENT_SCOPE)
endfunction()

# Extract unique directories containing header files
get_directories(HEADER_DIRECTORIES ${LIBRARY_HEADER_FILES})

# Display the list of directories
message("Directories containing header files:")
foreach(dir ${HEADER_DIRECTORIES})
    message(" - ${dir}")
endforeach()

# message("Setting the path to the open-csmp include files: ${LIBRARY_HEADER_FILES}")
# (prints all files) message("Setting the path to the open-csmp source files: ${LIBRARY_SOURCE_FILES}")

# VARIABLE SETS generated by open-csmp/source/variable_set_preprocessor*  using EXCEL *.csv (CSMP-variables.txt) files as input
set(VARIABLE_INDEX_SETS
    ${CMAKE_SOURCE_DIR}/../VariableSet_TracerTransfer.h
    ${CMAKE_SOURCE_DIR}/../VariableSet_TwoPhaseFlow.h
    ${CMAKE_SOURCE_DIR}/../VariableSet_CO2GeoSequestration.h
)
message("Current VariableSet include files: ${VARIABLE_INDEX_SETS}")


# ============================================================================
# THIRD PARTY LIBRARIES WITH NO DEPENDENCY ON CSMP
# ============================================================================

# iaps_h2o_eos library (equation of state for water)
file(GLOB_RECURSE IAPS_H2O_EOS_SOURCE_FILES
    "thirdparty/iaps_h2o_eos/*.cpp"
)
include_directories(${CMAKE_SOURCE_DIR}/thirdparty/iaps_h2o_eos)
add_library(iaps_h2o_eos ${IAPS_H2O_EOS_SOURCE_FILES})
# target_compile_options(YourLibraryName PRIVATE -Wall -Wextra)
install(TARGETS iaps_h2o_eos DESTINATION /bin)


# JPEG library (butchered and ported version included with open-csmp)
file(GLOB_RECURSE JPEG_SOURCE_FILES
    "thirdparty/jpeg/*.cpp"
)
include_directories(${CMAKE_SOURCE_DIR}/thirdparty/jpeg)
add_library(jpeg ${JPEG_SOURCE_FILES})
# target_compile_options(YourLibraryName PRIVATE -Wall -Wextra)
install(TARGETS jpeg DESTINATION /bin)


# MESCHACH matrix algebra library C++ port from Steve Roberts 
# (has its own makefile and is herewith included into the CMake tree)
# CURRENTLY COMPILED INDEPENDENTLY  add_subdirectory(${CMAKE_SOURCE_DIR}/thirdparty/meschach/source)


# Path to EIGEN linear algebra open source library
# set(EIGEN_INCLUDE_DIR ${CMAKE_SOURCE_DIR}/thirdparty/eigen/eigen/Eigen)
set(EIGEN_INCLUDE_DIR ${CMAKE_SOURCE_DIR}/thirdparty/eigen)
message("This is the path set to the Eigen library: ${EIGEN_INCLUDE_DIR}")

file(GLOB_RECURSE EIGEN_FILES
     ${EIGEN_INCLUDE_DIR}/eigen/Eigen/*
     ${EIGEN_INCLUDE_DIR}/eigen/Eigen/*.h
)


# CGNS LIBRARY stub (a single header file)
include_directories(${CMAKE_SOURCE_DIR}/thirdparty/cgns)

# CATCH2 unit testing framework entirely based on macros
include_directories(${CMAKE_SOURCE_DIR}/thirdparty/catch2)


# ============================================================================
# MAKING THE OPEN_CSMP LIBRARY
# ============================================================================

# Add your library target (excluding SAMG related files)
include_directories(${CMAKE_SOURCE_DIR}/../ ${EIGEN_INCLUDE_DIR} ${HEADER_DIRECTORIES})
add_library(open-csmp-core-library ${LIBRARY_SOURCE_FILES} ${LIBRARY_HEADER_FILES} ${VARIABLE_INDEX_SETS} ${EIGEN_FILES})

# Check if 'samg' option is enabled and define the macro accordingly
option(samg "Enable SAMG Solver" OFF)
if(samg)
    message("Compiling the open-csmp library for use with Fraunhofer's SAMG solver")
    add_compile_definitions(CSMP_WITH_SAMG_SOLVER SAMG_UNIX_LINUX SAMG_LCASE_USCORE SAMG_MULTIPLE_INSTANCES)
    
    # Include SAMG related files only if 'samg' option is enabled
    file(GLOB_RECURSE SAMG_FILES
        "thirdparty/samg/samg.h"
        "thirdparty/samg/samg1.h"
        "thirdparty/samg/samg2.h"
        "thirdparty/samg/samg3.h"
        "thirdparty/samg/samg4.h"
        "thirdparty/samg/samg5.h"
        "source/includes/integration/solver/SAMG_Settings.h"
        "source/includes/integration/solver/SAMG_Solver.h"
        "source/includes/integration/solver/SAMG_Configurator.h"
        "source/includes/integration/solver/SAMG_Settings.h"
        "source/modules/integration/solver/SAMG_Settings.cpp"
        "source/modules/integration/solver/SAMG_Solver.cpp"
        "source/modules/integration/solver/SAMG_Configurator.cpp"
        "source/modules/integration/solver/SAMG_Exception.cpp"
        "source/modules/integration/solver/SAMG_profiles/SAMG_Profile.h"
        "source/modules/integration/solver/SAMG_profiles/SAMG_Profile.cpp"
        "source/modules/integration/solver/SAMG_profiles/SteadyStateDiffusionProfile.h"
        "source/modules/integration/solver/SAMG_profiles/SteadyStateDiffusionProfile.cpp"
        "source/modules/integration/solver/SAMG_profiles/TwoPhaseImplicitNodeCenteredFVTransProfile.h"
        "source/modules/integration/solver/SAMG_profiles/TwoPhaseImplicitNodeCenteredFVTransProfile.cpp"
    )

   # Extract unique directories containing header files
   get_directories(SAMG_HEADER_DIRECTORIES ${SAMG_FILES})

   # Display the list of directories
   message("Directories containing SAMG header files:")
   foreach(dir ${SAMG_HEADER_DIRECTORIES})
      message(" - ${dir}")
   endforeach()

    # define paths to the SAMG subdirectories inside of thirdparty (TODO: deal with platform dependence)
    # Add SAMG related files to the library target
    target_sources(open-csmp-core-library PRIVATE ${SAMG_FILES})
    target_include_directories(open-csmp-core-library PUBLIC ${SAMG_HEADER_DIRECTORIES} ${CMAKE_SOURCE_DIR}/thirdparty/samg)
endif()


# ============================================================================
# EXAMPLES
# ============================================================================

# Define your examples source files
file(GLOB_RECURSE EXAMPLES_SOURCE_FILES
    "examples/source/*.h"
    "examples/source/*.cpp"
)

# Add an executable target for the examples
add_executable(open-csmp-examples ${EXAMPLES_SOURCE_FILES} ${LIBRARY_HEADER_FILES} ${VARIABLE_INDEX_SETS} ${JPEG_SOURCE_FILES} ${EIGEN_FILES})
target_include_directories(open-csmp-examples PRIVATE ${HEADER_DIRECTORIES} ${EIGEN_INCLUDE_DIR} ${CMAKE_SOURCE_DIR}/thirdparty/catch2) 

# Linking csmp examples and third-party libraries to the examples executable
target_link_libraries(open-csmp-examples open-csmp-core-library iaps_h2o_eos)

# Optionally, if there are additional dependencies, link them here
option( samg "Enable SAMG Solver" OFF)
if(samg)
    message("Compiling the open-csmp examples for use with Fraunhofer's SAMG solver")
    add_compile_definitions(CSMP_WITH_SAMG_SOLVER SAMG_UNIX_LINUX SAMG_LCASE_USCORE SAMG_MULTIPLE_INSTANCES)

    # Include SAMG related files only if 'samg' option is enabled
    file(GLOB_RECURSE SAMG_EXAMPLE_FILES
        "thirdparty/samg/samg.h"
        "thirdparty/samg/samg1.h"
        "thirdparty/samg/samg2.h"
        "thirdparty/samg/samg3.h"
        "thirdparty/samg/samg4.h"
        "thirdparty/samg/samg5.h"
        "source/includes/integration/solver/SAMG_Settings.h"
        "source/includes/integration/solver/SAMG_Solver.h"
        "source/includes/integration/solver/SAMG_Configurator.h"
        "source/includes/integration/solver/SAMG_Settings.h"
        "source/modules/integration/solver/SAMG_Settings.cpp"
        "source/modules/integration/solver/SAMG_Solver.cpp"
        "source/modules/integration/solver/SAMG_Configurator.cpp"
        "source/modules/integration/solver/SAMG_Exception.cpp"
        "source/modules/integration/solver/SAMG_profiles/SAMG_Profile.h"
        "source/modules/integration/solver/SAMG_profiles/SAMG_Profile.cpp"
        "source/modules/integration/solver/SAMG_profiles/SteadyStateDiffusionProfile.h"
        "source/modules/integration/solver/SAMG_profiles/SteadyStateDiffusionProfile.cpp"
        "source/modules/integration/solver/SAMG_profiles/TwoPhaseImplicitNodeCenteredFVTransProfile.h"
        "source/modules/integration/solver/SAMG_profiles/TwoPhaseImplicitNodeCenteredFVTransProfile.cpp"
    )

   # Extract unique directories containing header files
   get_directories(SAMG_HEADER_DIRECTORIES2 ${SAMG_EXAMPLE_FILES})

   # Display the list of directories
   message("Directories containing SAMG header files:")
   foreach(dir ${SAMG_HEADER_DIRECTORIES2})
      message(" - ${dir}")
   endforeach()

   # Add SAMG related files to the examples target
   target_sources(open-csmp-examples PRIVATE ${SAMG_EXAMPLE_FILES})
   # DO NOT USE THIS TROUBLED COMMAND: link_directories(${CMAKE_SOURCE_DIR}/thirdparty/samg/linux)
   # search with the added benefit of confirmation before compilation
   find_library(SAMG_LIB NAMES amg_mult HINTS "thirdparty/samg/linux")
   if(NOT SAMG_LIB)
     message(FATAL_ERROR "Library not found: 'libamg_mult.so'")
   endif()
   find_library(OMP_LIB NAMES iomp5 HINTS "thirdparty/samg/linux")
   if(NOT OMP_LIB)
     message(FATAL_ERROR, "Library not found: 'libiomp5.so'")
   endif()
   target_link_libraries(open-csmp-examples ${SAMG_LIB} ${OMP_LIB})
   target_include_directories(open-csmp-examples PUBLIC 
                              ${SAMG_HEADER_DIRECTORIES2}
   )
endif()

# Optionally, set additional compiler flags for the examples executable
# target_compile_options(open-csmp::examples PRIVATE -Wall -Wextra)


# CONDITIONAL COMPILATION

# OPTIMISATION & PROFILING

 # interprocedural optimisaton
  include(CheckIPOSupported)
  check_ipo_supported(RESULT result)
  if(result)
    set_target_properties(open-csmp-core-library PROPERTIES INTERPROCEDURAL_OPTIMIZATION TRUE)
  endif()


