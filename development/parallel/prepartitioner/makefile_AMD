######################################
# COMPLEX SYSTEMS PLATFORM MAKEFILE
######################################

CSP_ALG   = ../../algorithms
CSP_MAIN  = ../../main_library
CSP_FEM   = ../../finite_elements
CSP_MATH  = ../../applied_math
CSP_IFS   = ../../interfaces
CSP_CGEO  = ../../computational_geometry
CSP_TWO   = ../../two_phase_flow
CSP_PDE   = ../../pde_operators
CSP_EOS   = ../../eos
EOS_NACL  = ../../eos/eos_nacl_h2o
EOS_H2O   = ../../eos/eos_h2o
CSP_TFV   = ../../triangular_finite_volumes
CSP_VIS   = ../../visitors
CSP_INT   = ../../interrelations
CSP_SOLV  = ../../solver
CSP_PAR   = ../../parallel
CSP_GFVN  = ../../generic_node_centered_finite_volumes
CSP_GFVE  = ../../generic_element_centered_finite_volumes
CSP_LIB   = ../../../libraries
JPEG      = ../../../support_libraries/jpeg
F2C       = ../../../support_libraries/f2c
MESCHACH  = ../../../support_libraries/meschach
METIS     = ../../../support_libraries/metis-4.0
MPICH     = ../../../support_libraries/mpich2/
CSP       = .././

INCFLAG = -I$(JPEG) -I$(F2C) -I$(MESCHACH) -I$(CSP_MAIN) -I$(CSP_FEM) -I$(CSP) -I$(MPICH) \
          -I$(CSP_MATH) -I$(CSP_IFS) -I$(CSP_CGEO) -I$(CSP_TWO) -I$(CSP_PDE) -I$(CSP_EOS) -I$(CSP_PAR) -I$(METIS) \
	  -I$(EOS_NACL) -I$(EOS_H2O) -I$(CSP_TFV) -I$(CSP_VIS) -I$(CSP_INT) -I$(CSP_ALG) -I$(CSP_SOLV)  -I$(CSP_GFVN)  -I$(CSP_GFVE)

LIBS = -L$(CSP_LIB) -lmeschach_EMT64 -lcsp3D_EMT64_par -lf2c_EMT64 -ljpeg_EMT64 -lcsp3D_EMT64_basic -lcsp3D_EMT64_fem -lcsp3D_EMT64_algo \
                    -lcsp3D_EMT64_interfaces -lcsp3D_EMT64_interrelations -lcsp3D_EMT64_compgeo -lcsp3D_EMT64_amath -lcsp3D_EMT64_par -lmetis \
                    -lcsp3D_EMT64_2phase -lcsp3D_EMT64_visitors -lcsp3D_EMT64_eos -lcsp3D_EMT64_tfv -lcsp3D_EMT64_gefv -lcsp3D_EMT64_gnfv -lcsp3D_EMT64_pde \
                    -lcsp3D_EMT64_solver -lcsp3D_EMT64_basic -lcsp3D_EMT64_amath -ljpeg_EMT64 -lmeschach_EMT64 -lf2c_EMT64 -lamg_emt64_dum -lcsp3D_EMT64_par \
                    -lmpich -lmpichcxx -lmetis
# -lamg_emt64-libstdc++_x64_se9

CC = g++ -m64 -march=opteron -O3 -ffast-math -funroll-all-loops -fpeel-loops \
         -ftracer -funswitch-loops -ftree-vectorize -DSAMG_UNIX_LINUX \
         -DSAMG_LCASE_USCORE  -Wno-deprecated -Wno-reorder -Wno-unused -Wno-switch \
         -frtti -fexceptions -DCSP_WITH_SAMG_SOLVER -DNDEBUG

# Compilation
.SUFFIXES : .cpp .cc .c .o .test

.cc.o : 
	$(CC) -c $(CFLAGS) $(INCFLAG) $<

.cpp.o : 
	$(CC) -c $(CFLAGS) $(INCFLAG) $< 

.c.o :
	$(CC) -c $(CFLAGS) $(INCFLAG) $<

.o.:
	$(CC) $(CFLAGS) -o $@ $<

##########################
# Source Files
##########################
OBJS =  \
main_prepartitioner.o
OBJS2 =  \
mesh_to_vset.o

#########################
# Linking
#########################

Prepartitioner : $(OBJS)
	$(CC) -o $@ $(LIBS) $(OBJS) $(LIBS) $(LIBS) $(LIBS)

mesh_to_vset : $(OBJS2)
	$(CC) -o $@ $(LIBS) $(OBJS2) $(LIBS) $(LIBS) $(LIBS)

clean :
	-rm $(OBJS) $(OBJS2)

veryclean :
	-rm $(OBJS) $(OBJS2)
#########################












