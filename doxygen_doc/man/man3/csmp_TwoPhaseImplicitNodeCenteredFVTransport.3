class csmp::TwoPhaseImplicitNodeCenteredFVTransport< dim, STP >""generic_node_centered_finite_volumes/TwoPhaseImplicitNodeCenteredFVTransport\&.h"

.PP
\fBAuthor\fP
.RS 4
S\&.K\&. Matthaei 
.RE
.PP
