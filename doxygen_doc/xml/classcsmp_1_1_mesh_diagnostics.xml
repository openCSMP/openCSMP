        <name>ComputeQualityMetricsAndOutputToVTU</name>
        <qualifiedname>csmp::MeshDiagnostics::ComputeQualityMetricsAndOutputToVTU</qualifiedname>
        <param>
          <type><ref refid="classcsmp_1_1_model" kindref="compound">Model</ref>&lt; dim &gt; &amp;</type>
          <defname>model</defname>
        </param>
        <param>
