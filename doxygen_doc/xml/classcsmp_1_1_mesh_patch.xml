        <name>BuildInterveningPatch</name>
        <qualifiedname>csmp::MeshPatch::BuildInterveningPatch</qualifiedname>
        <param>
          <type>const std::vector&lt; std::pair&lt; std::pair&lt; <ref refid="classcsmp_1_1_element" kindref="compound">Element</ref>&lt; dim &gt; *, uint32_t &gt;, std::pair&lt; <ref refid="classcsmp_1_1_element" kindref="compound">Element</ref>&lt; dim &gt; *, uint32_t &gt; &gt; &gt; &amp;</type>
