        <definition>void csmp::NumIntegral_BT_D_op_dV&lt; dim, CELL &gt;::GetOperands</definition>
        <argsstring>(const CELL&lt; dim &gt; &amp;) override final</argsstring>
        <name>GetOperands</name>
        <qualifiedname>csmp::NumIntegral_BT_D_op_dV::GetOperands</qualifiedname>
        <reimplements refid="classcsmp_1_1_math_operator_r_h_s_1ad5614fa4de569146a684d28635eb9ff7">GetOperands</reimplements>
