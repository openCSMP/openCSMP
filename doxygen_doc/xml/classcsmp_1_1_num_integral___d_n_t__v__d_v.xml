      <memberdef kind="function" id="classcsmp_1_1_num_integral___d_n_t__v__d_v_1adfb663261264ca7990a4ef07c081476e" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type></type>
        <definition>csmp::NumIntegral_DNT_v_dV&lt; dim, CELL &gt;::NumIntegral_DNT_v_dV</definition>
        <argsstring>(const PropertyDatabase&lt; dim &gt; &amp;, const char *oper, const char *r_factor, const char *dens, const char *test)</argsstring>
        <name>NumIntegral_DNT_v_dV</name>
        <qualifiedname>csmp::NumIntegral_DNT_v_dV::NumIntegral_DNT_v_dV</qualifiedname>
        <param>
          <type>const <ref refid="classcsmp_1_1_property_database" kindref="compound">PropertyDatabase</ref>&lt; dim &gt; &amp;</type>
          <defname>pref</defname>
        </param>
        <param>
          <type>const char *</type>
          <declname>oper</declname>
        </param>
        <param>
          <type>const char *</type>
          <declname>r_factor</declname>
        </param>
        <param>
          <type>const char *</type>
          <declname>dens</declname>
        </param>
        <param>
