        <definition>csmp::NumIntegral_NT_mixed_op_dNi_dV&lt; dim, CELL &gt;::NumIntegral_NT_mixed_op_dNi_dV</definition>
        <argsstring>(const PropertyDatabase&lt; dim &gt; &amp;, const char *nodal_mtrl_multiplier, const char *oper, const char *mtrl, const char *test)</argsstring>
        <name>NumIntegral_NT_mixed_op_dNi_dV</name>
