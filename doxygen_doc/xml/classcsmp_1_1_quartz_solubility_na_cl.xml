    <briefdescription>
    </briefdescription>
    <detaileddescription>
<para><itemizedlist>
<listitem><para>aqueous solubility according to empirical formula of Fournier &amp; Potter, GCA 46, p. 1969-73.</para>
</listitem><listitem><para>correction for the presence sodium chloride according to Fournier 1983, GCA 47, p. 579-586. </para>
</listitem></itemizedlist>
</para>
    </detaileddescription>
