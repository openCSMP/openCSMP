<parameternamelist>
<parametername>axis</parametername>
</parameternamelist>
<parameterdescription>
<para>is either of the x, y or z coordinate axes in the Kartesian system </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>angle</parametername>
</parameternamelist>
<parameterdescription>
<para>is the angle in degress (0..360) </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
