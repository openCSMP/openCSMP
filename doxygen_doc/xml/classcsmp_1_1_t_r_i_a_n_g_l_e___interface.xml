        <argsstring>(const char *fname, VSet&lt; dim &gt; &amp;, bool isoparametric=false, bool perform_extra_checks=false)</argsstring>
        <name>ReadTriangle2DMesh</name>
        <qualifiedname>csmp::TRIANGLE_Interface::ReadTriangle2DMesh</qualifiedname>
        <param>
          <type>const char *</type>
          <declname>fname</declname>
        </param>
        <param>
          <type><ref refid="classcsmp_1_1_v_set" kindref="compound">VSet</ref>&lt; dim &gt; &amp;</type>
          <defname>vset</defname>
